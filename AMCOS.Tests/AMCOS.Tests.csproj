<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.5.0" />
    <PackageReference Include="MSTest.TestFramework" Version="3.5.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AMCOS.Data\AMCOS.Data.csproj" />
    <ProjectReference Include="..\AMCOS.Logic\AMCOS.Logic.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="ConfigurationMigrationTests.cs" />
    <Compile Include="TestMethods.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <!-- Tier 1: pure-logic tests (no database) written against the .NET Core app.
         NOTE: SecurityHelper/ExportHelper/KeyCloakHelper are <Compile Remove>d from
         AMCOS.Logic (legacy, superseded), so they are not testable from here. -->
    <Compile Include="Helpers\AdminHelperTest.cs" />
    <Compile Include="Logic\UserAdministrationLogicTest.cs" />
    <Compile Include="Attributes\EmailAddressOrNullTest.cs" />
    <Compile Include="Attributes\ValidationAttributesTest.cs" />
    <!-- Tier 2: DB-integration tests. [TestCategory("Integration")]; Inconclusive when
         no database is reachable. Require the migrations + demo seed. -->
    <Compile Include="Integration\DatabaseIntegrationTests.cs" />
    <Compile Include="Integration\LocalDashboardsTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
