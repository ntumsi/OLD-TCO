@page "{projectId:int?}"
@model AMCOS.Web.Core.Pages.App.Project.ReportModel
@{
    ViewData["Title"] = "Project Report";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-0">Project Manager Report</h1>
        <p class="text-muted mb-0">Project Id: @(Model.ProjectId?.ToString() ?? "Not supplied")</p>
    </div>
    @if (Model.ProjectId.HasValue)
    {
        <form method="post" asp-page-handler="Export">
            <input type="hidden" name="projectId" value="@Model.ProjectId" />
            <button type="submit" class="btn btn-success">Export Excel</button>
        </form>
    }
</div>

@if (!string.IsNullOrWhiteSpace(Model.LoadError))
{
    <div class="alert alert-warning">@Model.LoadError</div>
}
else if (Model.ProjectDetails is null)
{
    <div class="alert alert-info">Select a project from Project Manager to load report data.</div>
}
else
{
    <div class="row g-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">Report Properties</div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-3">Project Creator</dt><dd class="col-sm-9">@Model.ProjectDetails.ProjectCreator</dd>
                        <dt class="col-sm-3">Create Date</dt><dd class="col-sm-9">@Model.ProjectDetails.CreateDate.ToString("g")</dd>
                        <dt class="col-sm-3">Last Update</dt><dd class="col-sm-9">@Model.ProjectDetails.LastUpdate.ToString("g")</dd>
                        <dt class="col-sm-3">Project Name</dt><dd class="col-sm-9">@Model.ProjectDetails.ProjectName</dd>
                        <dt class="col-sm-3">Description</dt><dd class="col-sm-9">@Model.ProjectDetails.Description</dd>
                        <dt class="col-sm-3">Start Year</dt><dd class="col-sm-9">@Model.ProjectDetails.YearStart</dd>
                        <dt class="col-sm-3">Duration</dt><dd class="col-sm-9">@Model.ProjectDetails.YearDuration</dd>
                    </dl>
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card">
                <div class="card-header">Report Selection</div>
                <div class="card-body">
                    @await Html.PartialAsync("_DataTable", Model.ReportSelections)
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card">
                <div class="card-header">Inflation Factors</div>
                <div class="card-body">
                    <p class="small">
                        The current Joint Inflation Calculator (JIC) found on the OASA (FM&amp;C) website,
                        <a href="http://asafm.army.mil/offices/CE/Rates.aspx?OfficeCode=1400" target="_blank" rel="noopener">http://asafm.army.mil/offices/CE/Rates.aspx?OfficeCode=1400</a>,
                        is the source for the fourteen (14) inflation factors built into Project Manager (PM). Each component
                        (Active, NG, &amp; Reserves) has their own separate set of "MPA", "MPA Non Pay", &amp; "OMA" inflation factors
                        and Civilian (GS, WG, WL, WS, &amp; SES) positions are only inflated by two inflation factors, "CivPay" or
                        "OMA". The "MPA" inflation factor is applied to all MPA Appropriation (APPN) cost elements except Permanent
                        Change of Station (PCS) related cost elements. In this case, the "MPA Non Pay" inflation factor is applied
                        to a PCS cost element. When AMCOS LITE displays APPN = "OMA" or "Other", the "OMA" inflation factor is
                        applied to any cost element with either APPN.
                    </p>
                    @await Html.PartialAsync("_DataTable", Model.InflationFactors)
                    <div class="border rounded p-2 mt-3 small">
                        <div class="fw-bold text-decoration-underline">Inflation Calculation Note:</div>
                        <p class="mb-1">
                            In Project Manager (PM), the Fiscal Year (FY) costs generated in AMCOS LITE will be referred to as
                            "BASE YEAR" costs. PM multiplies BASE YEAR costs by the appropriate target year INFLATION FACTOR
                            generating Future Start Year and/or Future Year Cost Element costs across the entire duration.
                        </p>
                        <div class="fw-bold text-decoration-underline">For Example</div>
                        <p class="mb-1">
                            The Project Start Year (YearStart) is set to @Model.ProjectDetails.YearStart and the number of years
                            (YearDuration) is set to 5 years for costing an Active Duty position with the focus on "SALARY" cost element:
                        </p>
                        <ul class="mb-0">
                            <li>@Model.ProjectDetails.YearStart Active Duty Salary = (AMCOS LITE "Avg Cost Base Pay (Military)" BASE YEAR SALARY) * (@Model.ProjectDetails.YearStart Active Duty MPA Inflation Factor)</li>
                            <li>@(Model.ProjectDetails.YearStart + 1) Active Duty Salary = (AMCOS LITE "Avg Cost Base Pay (Military)" BASE YEAR SALARY) * (@(Model.ProjectDetails.YearStart + 1) Active Duty MPA Inflation Factor)</li>
                            <li>@(Model.ProjectDetails.YearStart + 2) Active Duty Salary = (AMCOS LITE "Avg Cost Base Pay (Military)" BASE YEAR SALARY) * (@(Model.ProjectDetails.YearStart + 2) Active Duty MPA Inflation Factor)</li>
                            <li>Repeating the Inflation process until the specified duration completes.</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card">
                <div class="card-header">Discounting and Present Value Factor (PVF)</div>
                <div class="card-body">
                    <p class="small">
                        Most cost comparison techniques take into consideration the time value of money, that is, a dollar today
                        is worth some amount less in the future. Discount rates are prepared annually by the Office of Management
                        and Budget (OMB). OMB Circular A-94 and Department of Defense Instruction (DoDI) 7041.3 require the use of a
                        discount rate based on the Treasury Department cost of borrowing funds, and reflect the expected cost of
                        borrowing for 3, 5, 7, 10, 20, and 30 years securities.
                    </p>
                    @if (!string.IsNullOrWhiteSpace(Model.DiscountRateHeading))
                    {
                        <p class="fw-bold mb-1">@Model.DiscountRateHeading</p>
                    }
                    @await Html.PartialAsync("_DataTable", Model.DiscountTable)
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card">
                <div class="card-header">Inventory</div>
                <div class="card-body">
                    @await Html.PartialAsync("_DataTable", Model.InventoryTable)
                </div>
            </div>
        </div>

        <div class="col-12">
            @{
                ViewData["CceSalaryLimit"] = Model.CceSalaryLimit;
                ViewData["YearColumns"] = Model.Cost?.YearColumns;
            }
            <div class="card">
                <div class="card-header">Cost Report</div>
                <div class="card-body">
                    @if (Model.Cost is null || Model.Cost.Undiscounted.Rows.Count == 0)
                    {
                        <div class="alert alert-light border mb-0">No cost data. Add inventory and build a report selection first.</div>
                    }
                    else
                    {
                        @if (Model.Cost.HasSpecialPay)
                        {
                            <div class="alert alert-info py-2 small">**Cost values are not inflated for the "Average Cost of Special Pays".</div>
                        }
                        @if (Model.Cost.CceOverSalaryLimit)
                        {
                            <div class="alert alert-warning py-2 small">NOTE: The highlighted field(s) indicate a value based on CCE salary greater than @Model.CceSalaryLimit.ToString("C0") per year.  The Contractor APPN Total sums the displayed CCE values but may be greater if your report includes highlighted cells.</div>
                        }

                        <h6 class="mb-2">Default Summary <span class="text-muted small">(undiscounted)</span></h6>
                        @await Html.PartialAsync("_CostReportTable", Model.Cost.Undiscounted)

                        <button class="btn btn-sm btn-outline-secondary mt-4 mb-2" type="button" data-bs-toggle="collapse"
                                data-bs-target="#divDiscount" aria-expanded="false" aria-controls="divDiscount">
                            Discounted Default Summary <span class="text-muted small">(present value)</span>
                        </button>
                        <div class="collapse" id="divDiscount">
                            @await Html.PartialAsync("_CostReportTable", Model.Cost.Discounted)
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}
