<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net48</TargetFrameworks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- The classic MVC/WebForms code (System.Web.*) can only compile for .NET Framework, so it
       is excluded ONLY from the net8.0 (Core) build. For net48 it is included and backed by the
       System.Web.Mvc / System.Web references below. -->
  <!-- Root AccountController.cs is a duplicate of Controllers/AccountController.cs (same class,
       same namespace); exclude it from BOTH targets so net48 doesn't see two definitions. -->
  <ItemGroup>
    <Compile Remove="AccountController.cs" />
  </ItemGroup>

  <!-- These shims re-create System.Web.UI.WebControls.ListItem / System.Web.Mvc.SelectListItem
       so net8 code compiles; on net48 the real framework types exist, so exclude the shims. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Compile Remove="Compatibility.ListItem.cs" />
    <Compile Remove="Compatibility.SelectListItem.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <Compile Remove="BasePage.cs" />
    <Compile Remove="Attributes\AdminOnly.cs" />
    <Compile Remove="Attributes\ValidateAntiForgeryTokenOnAllPosts.cs" />
    <Compile Remove="Controllers\**\*.cs" />
    <Compile Remove="Helpers\AthenaHelper.cs" />
    <Compile Remove="Helpers\EmailHelper.cs" />
    <Compile Remove="Helpers\ExportHelper.cs" />
    <Compile Remove="Helpers\KeyCloakHelper.cs" />
    <Compile Remove="Helpers\SameSiteCookieHelper.cs" />
    <Compile Remove="Helpers\SecurityHelper.cs" />
    <Compile Remove="WebControlUtil.cs" />
  </ItemGroup>

  <!-- Framework-independent packages. -->
  <ItemGroup>
    <PackageReference Include="AWSSDK.Athena" Version="3.7.403.75" />
    <PackageReference Include="AWSSDK.Core" Version="3.7.402.40" />
    <PackageReference Include="AWSSDK.QuickSight" Version="3.7.108.3" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!-- net8.0 (Core app): current EF Core 8 / Npgsql 8. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.8" />
    <PackageReference Include="Npgsql" Version="8.0.4" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.4" />
  </ItemGroup>

  <!-- net48 (classic AMCOS.Web app): EF Core 3.1 + Npgsql 4.1 (last lines running on .NET
       Framework), System.Web.Mvc for the classic controllers, and Aspose.Cells for the legacy
       ExportHelper. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="3.1.32" />
    <PackageReference Include="Npgsql" Version="4.1.12" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="3.1.18" />
    <PackageReference Include="Microsoft.AspNet.Mvc" Version="5.2.9" />
    <PackageReference Include="Aspose.Cells" Version="24.1.0" />
    <!-- Classic OWIN/Katana OpenID Connect auth stack (AccountController, KeyCloakHelper,
         SameSiteCookieHelper). -->
    <PackageReference Include="Owin" Version="1.0.0" />
    <PackageReference Include="Microsoft.Owin" Version="4.2.2" />
    <PackageReference Include="Microsoft.Owin.Host.SystemWeb" Version="4.2.2" />
    <PackageReference Include="Microsoft.Owin.Security" Version="4.2.2" />
    <PackageReference Include="Microsoft.Owin.Security.Cookies" Version="4.2.2" />
    <PackageReference Include="Microsoft.Owin.Security.OpenIdConnect" Version="4.2.2" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="6.35.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="6.35.0" />
    <Reference Include="System.Web" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.Web.ApplicationServices" />
    <Reference Include="System.IdentityModel" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="Microsoft.VisualBasic" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AMCOS.Data\AMCOS.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
