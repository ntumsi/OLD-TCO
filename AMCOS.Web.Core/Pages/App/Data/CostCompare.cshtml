@page
@model AMCOS.Web.Core.Pages.App.Data.CostCompareModel
@{
    ViewData["Title"] = "Cost Compare";
}

<h4>Cost Compare</h4>
<p class="text-muted">Total cost by grade level and cost-element category, for the selected pay plan and AMCOS version.</p>

@if (Model.LoadError != null)
{
    <div class="alert alert-info">@Model.LoadError</div>
}
else
{
    <form class="row row-cols-lg-auto g-2 align-items-end mb-3" id="filters">
        <div class="col">
            <label class="form-label mb-0" for="version">AMCOS Version</label>
            <select class="form-select" id="version">
                @foreach (var v in Model.Versions)
                {
                    <option value="@v" selected="@(v == Model.SelectedVersion)">@v</option>
                }
            </select>
        </div>
        <div class="col">
            <label class="form-label mb-0" for="payPlan">Pay Plan</label>
            <select class="form-select" id="payPlan">
                @foreach (var p in Model.PayPlans)
                {
                    <option value="@p" selected="@(p == Model.SelectedPayPlan)">@p</option>
                }
            </select>
        </div>
    </form>

    <div id="status" class="text-muted small mb-2"></div>
    <div id="costChart" style="min-height: 420px;"></div>

    <div class="table-responsive mt-3">
        <table class="table table-sm table-striped" id="costTable">
            <thead></thead>
            <tbody></tbody>
        </table>
    </div>
}

@section Scripts {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/c3/0.7.20/c3.min.css" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/d3/5.16.0/d3.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/c3/0.7.20/c3.min.js"></script>
    <script>
        (function () {
            const money = d3.format('$,.0f');
            const versionSel = document.getElementById('version');
            const payPlanSel = document.getElementById('payPlan');
            const statusEl = document.getElementById('status');

            let chart = c3.generate({
                bindto: '#costChart',
                data: { x: 'x', columns: [['x']], type: 'bar' },
                axis: {
                    x: { type: 'category', label: { text: 'Grade Level', position: 'outer-center' } },
                    y: { label: { text: 'Cost ($)', position: 'outer-middle' }, tick: { format: money } }
                },
                grid: { y: { show: true } },
                tooltip: { format: { value: function (v) { return money(v); } } }
            });

            async function load() {
                const version = versionSel.value;
                const payPlan = payPlanSel.value;
                if (!payPlan) { statusEl.textContent = 'No pay plans with cost data for this version.'; return; }
                statusEl.textContent = 'Loading…';
                try {
                    const res = await fetch(`?handler=Data&payPlan=${encodeURIComponent(payPlan)}&version=${encodeURIComponent(version)}`,
                        { headers: { Accept: 'application/json' } });
                    if (!res.ok) throw new Error('Request failed (' + res.status + ')');
                    const data = await res.json();
                    render(data);
                } catch (err) {
                    statusEl.textContent = 'Could not load cost data: ' + err.message;
                }
            }

            function render(data) {
                const grades = data.grades || [];
                const series = data.series || [];
                if (!grades.length || !series.length) {
                    chart.unload();
                    statusEl.textContent = 'No cost data for this selection.';
                    document.querySelector('#costTable thead').innerHTML = '';
                    document.querySelector('#costTable tbody').innerHTML = '';
                    return;
                }
                statusEl.textContent = '';

                const columns = [['x'].concat(grades.map(String))];
                series.forEach(s => columns.push([s.name].concat(s.values)));
                chart.load({ columns: columns, unload: true });

                // Table: rows = grade, columns = categories.
                const thead = '<tr><th>Grade</th>' + series.map(s => '<th class="text-end">' + s.name + '</th>').join('') + '</tr>';
                const tbody = grades.map((g, i) =>
                    '<tr><td>' + g + '</td>' +
                    series.map(s => '<td class="text-end">' + money(s.values[i] || 0) + '</td>').join('') +
                    '</tr>').join('');
                document.querySelector('#costTable thead').innerHTML = thead;
                document.querySelector('#costTable tbody').innerHTML = tbody;
            }

            // Changing the version refreshes the pay-plan list server-side (only plans with
            // data for that version); reload the page so the dropdown reflects it.
            versionSel.addEventListener('change', function () {
                window.location = `?version=${encodeURIComponent(versionSel.value)}`;
            });
            payPlanSel.addEventListener('change', load);
            load();
        })();
    </script>
}
