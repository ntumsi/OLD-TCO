@page
@model AMCOS.Web.Core.Pages.App.Data.InventoryDashboardModel
@{
    ViewData["Title"] = "Inventory";
}

<h4>Inventory</h4>
<p class="text-muted">Inventory head-count by grade level, compared between two AMCOS versions for the selected pay plan.</p>

@if (Model.LoadError != null)
{
    <div class="alert alert-info">@Model.LoadError</div>
}
else
{
    <form class="row row-cols-lg-auto g-2 align-items-end mb-3" id="filters">
        <div class="col">
            <label class="form-label mb-0" for="payPlan">Pay Plan</label>
            <select class="form-select" id="payPlan">
                @if (Model.PayPlans.Count == 0)
                {
                    <option value="">(no inventory loaded)</option>
                }
                @foreach (var p in Model.PayPlans)
                {
                    <option value="@p" selected="@(p == Model.SelectedPayPlan)">@p</option>
                }
            </select>
        </div>
        <div class="col">
            <label class="form-label mb-0" for="versionA">Version A</label>
            <select class="form-select" id="versionA">
                @foreach (var v in Model.Versions)
                {
                    <option value="@v" selected="@(v == Model.VersionA)">@v</option>
                }
            </select>
        </div>
        <div class="col">
            <label class="form-label mb-0" for="versionB">Version B</label>
            <select class="form-select" id="versionB">
                @foreach (var v in Model.Versions)
                {
                    <option value="@v" selected="@(v == Model.VersionB)">@v</option>
                }
            </select>
        </div>
    </form>

    <div id="status" class="text-muted small mb-2"></div>
    <div id="invChart" style="min-height: 420px;"></div>

    <div class="table-responsive mt-3">
        <table class="table table-sm table-striped" id="invTable">
            <thead></thead>
            <tbody></tbody>
        </table>
    </div>
}

@section Scripts {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/c3/0.7.20/c3.min.css" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/d3/5.16.0/d3.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/c3/0.7.20/c3.min.js"></script>
    <script>
        (function () {
            const count = d3.format(',');
            const signedPct = d3.format('+,.1f');
            // Percentage change from A to B. Undefined when A is 0 (shown as an em dash).
            function pctChange(a, b) {
                if (a === 0) return (b === 0) ? '0.0%' : '—';
                return signedPct((b - a) / a * 100) + '%';
            }
            const payPlanSel = document.getElementById('payPlan');
            const versionASel = document.getElementById('versionA');
            const versionBSel = document.getElementById('versionB');
            const statusEl = document.getElementById('status');

            let chart = c3.generate({
                bindto: '#invChart',
                data: { x: 'x', columns: [['x']], type: 'bar' },
                axis: {
                    x: { type: 'category', label: { text: 'Grade Level', position: 'outer-center' } },
                    y: { label: { text: 'Inventory (count)', position: 'outer-middle' }, tick: { format: count } }
                },
                grid: { y: { show: true } },
                tooltip: { format: { value: function (v) { return count(v); } } }
            });

            function clearTable() {
                document.querySelector('#invTable thead').innerHTML = '';
                document.querySelector('#invTable tbody').innerHTML = '';
            }

            async function load() {
                const payPlan = payPlanSel.value;
                const va = versionASel.value, vb = versionBSel.value;
                if (!payPlan) { statusEl.textContent = 'No inventory data is loaded for these versions yet.'; chart.unload(); clearTable(); return; }
                statusEl.textContent = 'Loading…';
                try {
                    const res = await fetch(`?handler=Data&payPlan=${encodeURIComponent(payPlan)}&versionA=${encodeURIComponent(va)}&versionB=${encodeURIComponent(vb)}`,
                        { headers: { Accept: 'application/json' } });
                    if (!res.ok) throw new Error('Request failed (' + res.status + ')');
                    render(await res.json());
                } catch (err) {
                    statusEl.textContent = 'Could not load inventory data: ' + err.message;
                }
            }

            function render(data) {
                const grades = data.grades || [];
                const a = data.a || [], b = data.b || [];
                const labelA = 'v' + data.versionA, labelB = 'v' + data.versionB;
                if (!grades.length) {
                    chart.unload();
                    statusEl.textContent = 'No inventory for this selection.';
                    clearTable();
                    return;
                }
                statusEl.textContent = data.versionA === data.versionB ? 'Version A and B are the same — pick two different versions to compare.' : '';

                chart.load({
                    columns: [['x'].concat(grades.map(String)), [labelA].concat(a), [labelB].concat(b)],
                    unload: true
                });

                const thead = `<tr><th>Grade</th><th class="text-end">${labelA}</th><th class="text-end">${labelB}</th><th class="text-end">&Delta; (B&minus;A)</th><th class="text-end">% Change</th></tr>`;
                const tbody = grades.map((g, i) => {
                    const va = a[i] || 0, vb = b[i] || 0, delta = vb - va;
                    const cls = delta > 0 ? 'text-success' : (delta < 0 ? 'text-danger' : '');
                    return `<tr><td>${g}</td><td class="text-end">${count(va)}</td><td class="text-end">${count(vb)}</td><td class="text-end ${cls}">${count(delta)}</td><td class="text-end ${cls}">${pctChange(va, vb)}</td></tr>`;
                }).join('');
                document.querySelector('#invTable thead').innerHTML = thead;
                document.querySelector('#invTable tbody').innerHTML = tbody;
            }

            payPlanSel.addEventListener('change', load);
            versionASel.addEventListener('change', load);
            versionBSel.addEventListener('change', load);
            load();
        })();
    </script>
}
