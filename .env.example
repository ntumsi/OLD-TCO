# Docker Compose overrides for the AMCOS backend (Postgres + Keycloak).
#
# Docker Compose automatically reads a ".env" file in this directory. Every value below is
# OPTIONAL — docker-compose.yml bakes in these same values as defaults (${VAR:-default}), so
# `docker compose up` works with no .env at all. Copy this file to ".env" only when you want to
# override something (ports already in use, different passwords, a pinned image tag, etc.):
#
#     cp .env.example .env      (PowerShell: Copy-Item .env.example .env)
#
# ".env" is git-ignored; only this template is committed.
#
# NOTE: this file configures the CONTAINERS. The .NET app is configured separately
# (AMCOS.Web.Core/appsettings.Development.json, or AMCOS.Web.Core/.env). If you change a port,
# database name, or the Keycloak client here, update the app's OIDC/connection settings to match.

# --- Image tags ---
POSTGIS_IMAGE=postgis/postgis:16-3.4
KEYCLOAK_DB_IMAGE=postgres:16-alpine
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.2

# --- Application database (amcos-db) ---
# Must match the app connection string in appsettings.json / appsettings.Development.json.
AMCOS_DB_NAME=amcos
AMCOS_DB_USER=postgres
AMCOS_DB_PASSWORD=postgr3s
AMCOS_DB_PORT=5432          # host port; change if 5432 is already taken locally

# --- Keycloak database (keycloak-db; internal only, no host port) ---
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak_password

# --- Keycloak server ---
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_HTTP_PORT=8180     # host port AND token-issuer port; if changed, update the app's
                            # OpenIdConnect__Authority and the redirect URIs in keycloak/cave-realm.json
KEYCLOAK_HOSTNAME=localhost
