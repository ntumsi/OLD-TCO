@page
@model AMCOS.Web.Core.Pages.App.Data.InventoryDashboardModel
@{
    ViewData["Title"] = "Inventory";
}

<h4>Inventory</h4>
<p class="text-muted">Inventory head-count by grade level and category group, for the selected pay plan and AMCOS version.</p>

@if (Model.LoadError != null)
{
    <div class="alert alert-info">@Model.LoadError</div>
}
else
{
    <form class="row row-cols-lg-auto g-2 align-items-end mb-3" id="filters">
        <div class="col">
            <label class="form-label mb-0" for="version">AMCOS Version</label>
            <select class="form-select" id="version">
                @foreach (var v in Model.Versions)
                {
                    <option value="@v" selected="@(v == Model.SelectedVersion)">@v</option>
                }
            </select>
        </div>
        <div class="col">
            <label class="form-label mb-0" for="payPlan">Pay Plan</label>
            <select class="form-select" id="payPlan">
                @if (Model.PayPlans.Count == 0)
                {
                    <option value="">(no inventory loaded)</option>
                }
                @foreach (var p in Model.PayPlans)
                {
                    <option value="@p" selected="@(p == Model.SelectedPayPlan)">@p</option>
                }
            </select>
        </div>
    </form>

    <div id="status" class="text-muted small mb-2"></div>
    <div id="invChart" style="min-height: 420px;"></div>

    <div class="table-responsive mt-3">
        <table class="table table-sm table-striped" id="invTable">
            <thead></thead>
            <tbody></tbody>
        </table>
    </div>
}

@section Scripts {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/c3/0.7.20/c3.min.css" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/d3/5.16.0/d3.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/c3/0.7.20/c3.min.js"></script>
    <script>
        (function () {
            const count = d3.format(',');
            const versionSel = document.getElementById('version');
            const payPlanSel = document.getElementById('payPlan');
            const statusEl = document.getElementById('status');

            let chart = c3.generate({
                bindto: '#invChart',
                data: { x: 'x', columns: [['x']], type: 'bar', groups: [[]] },
                axis: {
                    x: { type: 'category', label: { text: 'Grade Level', position: 'outer-center' } },
                    y: { label: { text: 'Inventory (count)', position: 'outer-middle' }, tick: { format: count } }
                },
                grid: { y: { show: true } },
                tooltip: { format: { value: function (v) { return count(v); } } }
            });

            async function load() {
                const version = versionSel.value;
                const payPlan = payPlanSel.value;
                if (!payPlan) { statusEl.textContent = 'No inventory data is loaded for this version yet.'; chart.unload(); clearTable(); return; }
                statusEl.textContent = 'Loading…';
                try {
                    const res = await fetch(`?handler=Data&payPlan=${encodeURIComponent(payPlan)}&version=${encodeURIComponent(version)}`,
                        { headers: { Accept: 'application/json' } });
                    if (!res.ok) throw new Error('Request failed (' + res.status + ')');
                    render(await res.json());
                } catch (err) {
                    statusEl.textContent = 'Could not load inventory data: ' + err.message;
                }
            }

            function clearTable() {
                document.querySelector('#invTable thead').innerHTML = '';
                document.querySelector('#invTable tbody').innerHTML = '';
            }

            function render(data) {
                const grades = data.grades || [];
                const series = data.series || [];
                if (!grades.length || !series.length) {
                    chart.unload();
                    statusEl.textContent = 'No inventory for this selection.';
                    clearTable();
                    return;
                }
                statusEl.textContent = '';

                const columns = [['x'].concat(grades.map(String))];
                series.forEach(s => columns.push([s.name].concat(s.values)));
                // Stack the category groups so each bar is total inventory for the grade.
                chart.load({ columns: columns, unload: true });
                chart.groups([series.map(s => s.name)]);

                const thead = '<tr><th>Grade</th>' + series.map(s => '<th class="text-end">' + s.name + '</th>').join('') + '<th class="text-end">Total</th></tr>';
                const tbody = grades.map((g, i) => {
                    const total = series.reduce((sum, s) => sum + (s.values[i] || 0), 0);
                    return '<tr><td>' + g + '</td>' +
                        series.map(s => '<td class="text-end">' + count(s.values[i] || 0) + '</td>').join('') +
                        '<td class="text-end fw-bold">' + count(total) + '</td></tr>';
                }).join('');
                document.querySelector('#invTable thead').innerHTML = thead;
                document.querySelector('#invTable tbody').innerHTML = tbody;
            }

            versionSel.addEventListener('change', function () {
                window.location = `?version=${encodeURIComponent(versionSel.value)}`;
            });
            payPlanSel.addEventListener('change', load);
            load();
        })();
    </script>
}
